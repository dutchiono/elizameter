{
  "name": "@elizameter/plugin-widgets",
  "version": "0.0.1",
  "description": "Registers /api/widgets/* HTTP routes on a local Milady runtime for Rainmeter skins.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "vitest run",
    "typecheck": "tsc -p . --noEmit"
  },
  "peerDependencies": {
    "@elizaos/core": "*"
  },
  "devDependencies": {
    "@elizaos/core": "alpha",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "license": "MIT"
}
